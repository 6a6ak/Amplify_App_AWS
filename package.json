{
  "name": "amplify-app-aws",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview",
    "start:prod": "npm run build && node server/index.js",
    "serve": "npm run start:prod",
    "test:security": "node --test server/security.test.js server/public-telemetry.test.js server/aws_lambda/index.test.js && tsx --test amplify/functions/shared/ingestion.test.ts",
    "typecheck:backend": "tsc --noEmit -p amplify/tsconfig.json",
    "test:dependency-security": "node --test tests/dependency-security.test.cjs"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.13.1",
    "aws-amplify": "^6.15.8",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "react": "18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "18.2.0",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^7.10.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "braces": "file:./vendor/braces",
    "@graphql-tools/utils": "^12.0.1",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "graphql": "^15.8.0",
    "@aws-amplify/graphql-generator": "^0.5.4"
  },
  "overrides": {
    "handlebars": "^4.7.10",
    "immutable": "^3.8.4",
    "lodash": "^4.18.1",
    "@graphql-tools/utils": "$@graphql-tools/utils",
    "braces": "$braces",
    "@graphql-tools/schema": "^10.1.5",
    "@graphql-tools/merge": "^9.2.8",
    "@opentelemetry/core": "^2.8.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
